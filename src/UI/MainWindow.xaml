<Window x:Class="ThermalBridgeTool.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wärmebrücken-Nachweis" Height="430" Width="430"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Wärmebrücken-Nachweis" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Text="Workflow Schritt für Schritt ausführen." Margin="0,0,0,12" Foreground="Gray"/>

        <Button Content="1. Parameter prüfen / anlegen" Height="34" Margin="0,4" Click="Btn_Click" Tag="Params"/>
        <Button Content="2. Wärmebrücken automatisch erkennen" Height="34" Margin="0,4" Click="Btn_Click" Tag="Detect"/>
        <Button Content="3. Psi-Bibliothek laden" Height="34" Margin="0,4" Click="Btn_Click" Tag="LoadLib"/>
        <Button Content="4. Psi-Typen zuordnen" Height="34" Margin="0,4" Click="Btn_Click" Tag="Assign"/>
        <Button Content="5. Plausibilitätsprüfung ausführen" Height="34" Margin="0,4" Click="Btn_Click" Tag="Validate"/>
        <Button Content="6. Nachweisliste nach Excel/CSV exportieren" Height="34" Margin="0,4" Click="Btn_Click" Tag="Export"/>
        <Button Content="7. Auto-Marker löschen / neu erzeugen" Height="34" Margin="0,4" Click="Btn_Click" Tag="Recreate"/>

        <Button Content="Schließen" Height="30" Margin="0,12,0,0" Click="Btn_Click" Tag="Close"/>
    </StackPanel>
</Window>
