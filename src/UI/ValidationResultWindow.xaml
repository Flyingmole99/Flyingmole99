<Window x:Class="ThermalBridgeTool.UI.ValidationResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plausibilitätsprüfung" Height="520" Width="820"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock x:Name="TxtSummary" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Schließen" Width="90" Click="BtnClose_Click"/>
        </StackPanel>
        <DataGrid x:Name="GridIssues" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Schwere" Binding="{Binding Severity}" Width="80"/>
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="140"/>
                <DataGridTextColumn Header="WB_ID" Binding="{Binding WbId}" Width="200"/>
                <DataGridTextColumn Header="Meldung" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
