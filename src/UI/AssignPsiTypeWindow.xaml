<Window x:Class="ThermalBridgeTool.UI.AssignPsiTypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Psi-Typen zuordnen" Height="520" Width="820"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8">
            Wärmebrücken auswählen, einen Psi-Typ-Code wählen und anwenden.
            Psi-Wert und Quelle werden aus der Bibliothek übernommen. Der Status
            wird nur dann auf „geprüft“ gesetzt, wenn dies ausdrücklich gewählt wird.
        </TextBlock>

        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <TextBlock Text="Psi-Typ:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="CmbPsi" Width="360" VerticalAlignment="Center"/>
                <CheckBox x:Name="ChkProven" Content="Status auf 'geprüft' setzen"
                          VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Column="1">
                <Button x:Name="BtnApply" Content="Auf Auswahl anwenden" Width="170"
                        Margin="0,0,8,0" Click="BtnApply_Click"/>
                <Button x:Name="BtnCancel" Content="Schließen" Width="90" Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>

        <DataGrid x:Name="GridBridges" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" Margin="0,0,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="WB_ID" Binding="{Binding Id}" Width="200"/>
                <DataGridTextColumn Header="Kategorie" Binding="{Binding Kategorie}" Width="150"/>
                <DataGridTextColumn Header="Untertyp" Binding="{Binding Untertyp}" Width="120"/>
                <DataGridTextColumn Header="Länge [m]" Binding="{Binding LaengeM, StringFormat=0.###}" Width="80"/>
                <DataGridTextColumn Header="Psi-Typ" Binding="{Binding PsiTyp}" Width="100"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
